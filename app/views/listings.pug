extends layout

block content
  .page-header
    h1 Browse Skills
    p Find someone in the community offering what you want to learn.

  .tag-list
    a.badge(href="/skills" class=selectedCategory ? "badge-gray" : "badge-blue") All
    each cat in categories
      a.badge(href=`/skills?cat=${encodeURIComponent(cat)}` class=cat === selectedCategory ? "badge-blue" : "badge-gray")= cat

  if skills.length === 0
    .card(style="padding: 1.5rem; text-align: center; color: var(--gray-500);")
      | No skills found in this category yet.
  else
    .grid-3
      each skill in skills
        a.card.skill-card(href="/skills/" + skill.id)
          .skill-card-header
            h3= skill.title
            span.badge.badge-blue= skill.category
          p= skill.description
          .skill-card-footer
            .skill-card-user
              .avatar(style="width:24px;height:24px;font-size:11px;")= skill.teacher ? skill.teacher[0] : 'U'
              span= skill.teacher
            span.badge.badge-gray= skill.level
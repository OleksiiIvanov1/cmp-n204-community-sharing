extends layout

block content
  .page-header
    h1 Join Community Share
    p Create an account to start sharing skills.

  if error
    .card(style="padding: 1rem; margin-bottom: 1rem; border-color: #EF4444; color: #B91C1C;")
      = error

  form(method="POST" action="/register" style="max-width: 420px;")
    .card(style="padding: 2rem;")
      label(for="name" style="display:block; font-size:13px; color:#475569; margin-bottom:6px;") Full name
      input#name(name="name" type="text" required style="width:100%; padding:10px 12px; border:1px solid #E2E8F0; border-radius:8px; margin-bottom:1rem; font-family:inherit; font-size:14px;")

      label(for="email" style="display:block; font-size:13px; color:#475569; margin-bottom:6px;") Email
      input#email(name="email" type="email" required style="width:100%; padding:10px 12px; border:1px solid #E2E8F0; border-radius:8px; margin-bottom:1rem; font-family:inherit; font-size:14px;")

      label(for="password" style="display:block; font-size:13px; color:#475569; margin-bottom:6px;") Password
      input#password(name="password" type="password" required minlength="8" style="width:100%; padding:10px 12px; border:1px solid #E2E8F0; border-radius:8px; margin-bottom:1.5rem; font-family:inherit; font-size:14px;")
      p(style="font-size:12px; color:#64748B; margin-top:-1rem; margin-bottom:1.5rem;") At least 8 characters.

      button.btn.btn-primary(type="submit" style="width:100%;") Create account

      p(style="text-align:center; font-size:13px; color:#64748B; margin-top:1rem;")
        | Already have an account?&nbsp;
        a(href="/login") Log in